# Nominatim is exposed only on the local/LAN server. Do not use a public OSM endpoint here.
LOCAL_GEOCODER_URL=http://127.0.0.1:7070
LOCAL_GEOCODER_TIMEOUT_SECONDS=8

# The browser reads the map style from the local tile service or a same-origin reverse proxy.
VUE_APP_LOCAL_MAP_STYLE_URL=http://127.0.0.1:7071/styles/basic/style.json
