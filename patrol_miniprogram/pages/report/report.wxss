.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-head .field-label {
  margin-bottom: 0;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.photo-cell {
  position: relative;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 32rpx;
  border-bottom-left-radius: 8rpx;
}
.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: linear-gradient(160deg, #f2f8ff, #eaf3ff);
  border: 2rpx dashed #9ec6ef;
  color: #4d88c7;
}
.add-plus { font-size: 52rpx; line-height: 1; }
.add-text { font-size: 24rpx; }

.loc-btn {
  margin: 0;
  color: #409eff;
  background: #ecf5ff;
}
.loc-result {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  color: #606266;
}

.form-item {
  margin-bottom: 26rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.input, .textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 12rpx;
  background: #f7fafd;
  font-size: 28rpx;
  color: #303133;
}
.textarea {
  min-height: 160rpx;
}
.picker-value {
  padding: 20rpx 22rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 12rpx;
  background: #f7fafd;
  font-size: 28rpx;
  color: #303133;
}
.picker-value.placeholder {
  color: #a8abb2;
}

.submit-btn {
  margin-top: 30rpx;
}
