.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-head .field-label {
  margin-bottom: 0;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.photo-cell {
  position: relative;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 32rpx;
  border-bottom-left-radius: 8rpx;
}
.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: #f0f4f2;
  border: 1rpx dashed #b9c6c1;
  color: #7c8783;
}
.add-plus { font-size: 52rpx; line-height: 1; }
.add-text { font-size: 24rpx; }

.loc-btn {
  margin: 0;
  color: #2f806b;
  background: #e8f2ee;
}
.loc-result {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  color: #4a5450;
}

.form-item {
  margin-bottom: 26rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.input, .textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e3e7e6;
  border-radius: 8rpx;
  background: #fbfcfc;
  font-size: 28rpx;
}
.textarea {
  min-height: 140rpx;
}
.picker-value {
  padding: 18rpx 20rpx;
  border: 1rpx solid #e3e7e6;
  border-radius: 8rpx;
  background: #fbfcfc;
  font-size: 28rpx;
}
.picker-value.placeholder {
  color: #9aa5a1;
}

.submit-btn {
  margin-top: 30rpx;
}
