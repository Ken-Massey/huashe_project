<view class="login-page">
  <view class="bg-deco bg-deco-1"></view>
  <view class="bg-deco bg-deco-2"></view>

  <view class="login-card">
    <view class="logo">
      <text class="logo-icon">🚇</text>
    </view>
    <view class="title">现场符合性巡查</view>
    <view class="subtitle">运营线路保护区 · 巡查员入口</view>

    <view class="form">
      <view class="field">
        <view class="input-wrap">
          <text class="input-icon">👤</text>
          <input
            class="input"
            data-field="username"
            value="{{ username }}"
            bindinput="onInput"
            placeholder="请输入账号"
            placeholder-class="ph"
            confirm-type="next"
          />
        </view>
      </view>
      <view class="field">
        <view class="input-wrap">
          <text class="input-icon">🔒</text>
          <input
            class="input"
            data-field="password"
            value="{{ password }}"
            bindinput="onInput"
            password
            placeholder="请输入密码"
            placeholder-class="ph"
            confirm-type="done"
            bindconfirm="submit"
          />
        </view>
      </view>
      <button class="login-btn" hover-class="login-btn-hover" disabled="{{ loading }}" bindtap="submit">
        {{ loading ? '登 录 中…' : '登 录' }}
      </button>
    </view>
  </view>

  <view class="footer">运营线路保护区综合管理服务智能体</view>
</view>
