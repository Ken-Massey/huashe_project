<view class="login-page">
  <!-- 背景装饰：地铁线路网 -->
  <view class="bg-deco bg-circle bg-c1"></view>
  <view class="bg-deco bg-circle bg-c2"></view>
  <view class="line line-1"></view>
  <view class="line line-2"></view>
  <view class="line line-3"></view>
  <view class="station station-1"></view>
  <view class="station station-2"></view>
  <view class="station station-3"></view>
  <view class="station station-4"></view>

  <view class="login-card">
    <view class="logo-wrap">
      <view class="logo-badge"><text class="logo-icon">🚇</text></view>
    </view>
    <view class="title">华设轨道智审</view>
    <view class="subtitle">运营线路保护区 · 现场符合性巡查</view>

    <view class="form">
      <view class="field">
        <view class="input-wrap {{ focusField === 'username' ? 'input-focus' : '' }} {{ loginError && !username ? 'input-error' : '' }}">
          <view class="input-icon-box"><text class="input-icon">👤</text></view>
          <input
            class="input"
            data-field="username"
            value="{{ username }}"
            bindinput="onInput"
            bindfocus="onFocus"
            bindblur="onBlur"
            placeholder="请输入账号"
            placeholder-class="ph"
            confirm-type="next"
            cursor-spacing="20"
          />
        </view>
      </view>
      <view class="field">
        <view class="input-wrap {{ focusField === 'password' ? 'input-focus' : '' }} {{ loginError && !password ? 'input-error' : '' }}">
          <view class="input-icon-box"><text class="input-icon">🔒</text></view>
          <input
            class="input"
            data-field="password"
            value="{{ password }}"
            bindinput="onInput"
            bindfocus="onFocus"
            bindblur="onBlur"
            password="{{ !showPassword }}"
            placeholder="请输入密码"
            placeholder-class="ph"
            confirm-type="done"
            bindconfirm="submit"
            cursor-spacing="20"
          />
          <view class="pwd-toggle" bindtap="togglePassword">
            <text>{{ showPassword ? '🙈' : '👁' }}</text>
          </view>
        </view>
      </view>

      <view class="error-msg" wx:if="{{ loginError }}">
        <text class="error-icon">⚠</text> {{ loginError }}
      </view>

      <button class="login-btn" hover-class="login-btn-hover" disabled="{{ loading }}" bindtap="submit">
        {{ loading ? '登 录 中…' : '登 录' }}
      </button>
    </view>
  </view>

  <view class="footer">运营线路保护区综合管理服务智能体</view>
</view>
