.login-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 60rpx 48rpx 120rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #13294b 0%, #1b3a67 32%, #2d5d95 58%, #6f9fc9 82%, #c3ddf2 100%);
}

/* 背景装饰（地铁线路网点缀） */
.bg-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}
.bg-deco-1 { width: 420rpx; height: 420rpx; top: -120rpx; right: -100rpx; }
.bg-deco-2 { width: 320rpx; height: 320rpx; bottom: 80rpx; left: -120rpx; }

.login-card {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 640rpx;
  padding: 56rpx 48rpx 48rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 24rpx 72rpx rgba(35, 82, 148, 0.22);
}

.logo {
  display: flex;
  justify-content: center;
  margin-bottom: 18rpx;
}
.logo-icon { font-size: 88rpx; }

.title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2d3d;
  letter-spacing: 4rpx;
}
.subtitle {
  margin: 12rpx 0 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8c9bab;
  letter-spacing: 4rpx;
}

.field { margin-bottom: 32rpx; }
.input-wrap {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 10rpx;
  background: #fff;
}
.input-icon { font-size: 32rpx; margin-right: 16rpx; }
.input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #303133;
}
.ph { color: #a8abb2; }

.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 12rpx;
  border-radius: 10rpx;
  background: #409eff;
  color: #fff;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  text-align: center;
}
.login-btn::after { border: none; }
.login-btn[disabled] { background: #a0cfff; color: #fff; }
.login-btn-hover { background: #337ecc; }

.footer {
  position: fixed;
  bottom: 32rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(35, 67, 105, 0.65);
  z-index: 2;
}
