.form-item { margin-bottom: 28rpx; }
.form-item:last-child { margin-bottom: 0; }
.field-label { display: block; margin-bottom: 12rpx; color: #606266; font-size: 26rpx; }
.required { color: #f56c6c; margin-right: 4rpx; }
.textarea, .input { width: 100%; box-sizing: border-box; padding: 20rpx 22rpx; border: 1rpx solid #dcdfe6; border-radius: 12rpx; background: #f7fafd; font-size: 28rpx; color: #303133; }
.textarea { min-height: 160rpx; }
.picker-value { padding: 20rpx 22rpx; border: 1rpx solid #dcdfe6; border-radius: 12rpx; background: #f7fafd; font-size: 28rpx; color: #303133; transition: border-color .2s; }
.picker-value:active { border-color: #409eff; }
.picker-value.placeholder { color: #a8abb2; }

.shot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.shot-cell { position: relative; height: 160rpx; border-radius: 12rpx; overflow: hidden; }
.shot-img { width: 100%; height: 100%; }
.shot-del { position: absolute; top: 0; right: 0; width: 44rpx; height: 44rpx; line-height: 40rpx; text-align: center; background: rgba(0,0,0,.55); color: #fff; font-size: 32rpx; border-bottom-left-radius: 12rpx; }
.shot-add {
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(160deg, #f2f8ff, #eaf3ff);
  border: 2rpx dashed #9ec6ef; color: #4d88c7; border-radius: 12rpx;
}
.add-plus { font-size: 52rpx; line-height: 1; font-weight: 300; }
.submit-btn { margin-top: 30rpx; box-shadow: 0 8rpx 22rpx rgba(64,158,255,.3); }
