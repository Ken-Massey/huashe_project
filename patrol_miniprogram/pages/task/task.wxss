/* ===== 任务信息卡 ===== */
.head-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.task-no { font-family: Consolas, monospace; font-size: 32rpx; font-weight: 600; color: #2d5d95; }
.task-name { font-size: 34rpx; font-weight: 700; margin-bottom: 16rpx; color: #1f2d3d; }
.info-row { display: flex; margin-bottom: 14rpx; font-size: 28rpx; color: #606266; }
.info-row:last-child { margin-bottom: 0; }
.info-label { flex: 0 0 150rpx; color: #909399; }

/* ===== 巡查要求突出块 ===== */
.require-card {
  background: #ecf5ff;
  border-left: 8rpx solid #409eff;
  border-radius: 0 12rpx 12rpx 0;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.require-title { font-size: 28rpx; font-weight: 700; color: #2d5d95; margin-bottom: 10rpx; }
.require-content { font-size: 27rpx; color: #303133; line-height: 1.7; }

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #303133;
  margin-bottom: 20rpx;
}
.section-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #409eff, #2d5d95);
  margin-right: 12rpx;
}

/* ===== 时间线 ===== */
.tl-item {
  position: relative;
  padding-left: 30rpx;
  margin-bottom: 28rpx;
}
.tl-item:last-child { margin-bottom: 0; }
.tl-item::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 10rpx;
  bottom: -18rpx;
  width: 3rpx;
  background: #e1ebf7;
}
.tl-item:last-child::before { bottom: 6rpx; }
.tl-item::after {
  content: '';
  position: absolute;
  left: -2rpx;
  top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #409eff;
  box-shadow: 0 0 0 6rpx rgba(64, 158, 255, 0.15);
}
.tl-head { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
.record-note { color: #606266; margin: 8rpx 0; font-size: 27rpx; }

/* ===== 隐患块 ===== */
.hazard-block {
  margin-top: 12rpx;
  padding: 20rpx 16rpx 16rpx;
  background: #fefafa;
  border: 1rpx solid #fbe3e3;
  border-radius: 12rpx;
}
.hazard-block.hazard-closed {
  background: #f5fbf3;
  border-color: #d9edc8;
}
.hazard-meta { display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
.hazard-desc { font-weight: 600; color: #303133; font-size: 27rpx; }
.hazard-req { color: #606266; font-size: 25rpx; margin-top: 6rpx; }
.hazard-ops { display: flex; align-items: center; gap: 20rpx; margin-top: 10rpx; }
.mini-btn {
  margin: 0;
  background: #ecf5ff;
  color: #409eff;
  font-size: 23rpx;
  border-radius: 999rpx;
}
.mini-btn::after { border: none; }
.link-btn { color: #409eff; font-size: 24rpx; }
.link-btn.danger { color: #f56c6c; }

/* ===== 整改记录嵌套 ===== */
.rectify-list {
  margin-top: 14rpx;
  padding: 14rpx;
  background: rgba(255,255,255,0.7);
  border-radius: 10rpx;
  border: 1rpx dashed #f0d0a0;
}
.rectify-title { font-size: 24rpx; font-weight: 600; color: #e6a23c; margin-bottom: 10rpx; }
.rectify-item { padding: 10rpx 0; border-top: 1rpx solid #f5e6d0; }
.rectify-item:first-of-type { border-top: none; padding-top: 0; }
.rectify-head { margin-bottom: 6rpx; }
.rectify-note { color: #606266; font-size: 25rpx; margin-bottom: 8rpx; }

/* ===== 媒体 ===== */
.shot-grid { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 8rpx 0; }
.shot-img { width: 140rpx; height: 140rpx; border-radius: 10rpx; background: #ecf3fb; }
.media-grid { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 8rpx; }
.media-cell-wrap { position: relative; width: 160rpx; height: 160rpx; border-radius: 10rpx; overflow: hidden; background: #ecf3fb; }
.media-img { width: 100%; height: 100%; }

/* 视频缩略图占位 */
.video-thumb {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #1f2d3d;
}
.video-thumb-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #2c3e50, #1a252f);
}
.video-thumb .video-play-btn {
  position: relative;
  top: auto; left: auto; transform: none;
  width: 56rpx; height: 56rpx; line-height: 56rpx;
  background: rgba(255,255,255,0.2);
  border: 2rpx solid rgba(255,255,255,0.6);
  font-size: 24rpx;
}
.video-thumb-label {
  position: relative;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

/* ===== 底部操作 ===== */
.actions {
  position: sticky;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245,247,250,0), #f5f7fa 34%);
}
.actions button { flex: 1; border-radius: 12rpx; }

/* ===== 整改图片上传浮层 ===== */
.rectify-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.rectify-panel {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}
.rectify-panel-title { font-size: 30rpx; font-weight: 700; color: #303133; margin-bottom: 16rpx; }
.rectify-thumbs { max-height: 320rpx; }
.rectify-thumb-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.rectify-thumb { width: 140rpx; height: 140rpx; border-radius: 10rpx; background: #ecf3fb; }
.rectify-note-label { font-size: 25rpx; color: #909399; margin: 16rpx 0 8rpx; }
.rectify-textarea {
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  border: 1rpx solid #dcdfe6;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 27rpx;
}
.rectify-panel-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.rectify-btn { flex: 1; border-radius: 999rpx; font-size: 27rpx; }
.rectify-btn.cancel { background: #f4f4f5; color: #606266; }
.rectify-btn.ok { background: #409eff; color: #fff; }
.rectify-btn::after { border: none; }

/* ===== 监测方案 ===== */
.monitor-card { background: #f8fbfe; border: 1rpx solid #e3edf7; }
.monitor-head { margin-bottom: 14rpx; }
.monitor-title { font-size: 28rpx; font-weight: 700; color: #2d5d95; }
.monitor-field { margin-bottom: 12rpx; }
.monitor-field-label { display: block; font-size: 22rpx; color: #909399; margin-bottom: 4rpx; }
.monitor-field-val { font-size: 27rpx; color: #303133; line-height: 1.6; word-break: break-all; }
.monitor-opinion { margin-top: 14rpx; padding: 16rpx; background: #fefaf0; border: 1rpx dashed #f0d0a0; border-radius: 10rpx; }
.monitor-opinion-label { font-size: 24rpx; font-weight: 600; color: #e6a23c; margin-bottom: 6rpx; }
.monitor-opinion-text { font-size: 26rpx; color: #303133; line-height: 1.6; word-break: break-all; }
.monitor-docs { margin-top: 14rpx; }
.monitor-docs-label { font-size: 24rpx; font-weight: 600; color: #606266; margin-bottom: 8rpx; }
.doc-item { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 10rpx; background: #fff; border: 1rpx solid #ebeef5; border-radius: 10rpx; margin-bottom: 8rpx; }
.doc-item:last-child { margin-bottom: 0; }
.doc-icon { font-size: 32rpx; }
.doc-name { flex: 1; min-width: 0; font-size: 25rpx; color: #303133; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.doc-link { flex: 0 0 auto; font-size: 25rpx; color: #409eff; padding: 0 4rpx; }
