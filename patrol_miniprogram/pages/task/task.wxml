<view class="page" wx:if="{{ task }}">
  <!-- 任务信息卡 -->
  <view class="card">
    <view class="head-row">
      <text class="task-no">{{ task.task_no }}</text>
      <text class="tag {{ task.status === 'pending' ? 'tag-pending' : (task.status === 'completed' ? 'tag-compliant' : 'tag-archived') }}">{{ task.statusLabel }}</text>
    </view>
    <view class="task-name">{{ task.name }}</view>
    <view class="info-row"><text class="info-label">线路</text><text>{{ task.line || '-' }}</text></view>
    <view class="info-row"><text class="info-label">位置</text><text>{{ task.location_desc || '-' }}</text></view>
    <view class="info-row"><text class="info-label">派发人</text><text>{{ task.dispatcher || '-' }}</text></view>
  </view>

  <!-- 巡查要求突出块 -->
  <view class="require-card" wx:if="{{ task.requirement }}">
    <view class="require-title">📋 巡查要求</view>
    <view class="require-content">{{ task.requirement }}</view>
  </view>

  <!-- 巡查时间线 -->
  <view class="card">
    <view class="section-title">巡查时间线</view>

    <block wx:for="{{ groups }}" wx:for-item="g" wx:key="dateKey">
      <view class="date-group-title {{ g.isToday ? 'today' : '' }}">{{ g.dateLabel }}</view>
      <view wx:for="{{ g.items }}" wx:for-item="item" wx:key="index" class="tl-item">
        <!-- 时间 + 巡查员 -->
        <view class="tl-head">
          <text wx:if="{{ item.kind === 'record' }}" class="tag {{ item.data.type === 'rectify' ? 'tag-pending' : 'tag-compliant' }}">{{ item.data.type === 'rectify' ? '整改反馈' : '日常巡查' }}</text>
          <text wx:else class="tag tag-noncompliant">风险隐患</text>
          <text class="muted">{{ item.data.created_by_name || '-' }} · {{ item.data.created_at }}</text>
          <text wx:if="{{ item.kind === 'record' && item.data.type === 'patrol' }}" class="link-btn" data-record="{{ item.data.record_id }}" bindtap="goAddHazard">＋添加隐患</text>
        </view>

        <view class="record-note" wx:if="{{ item.kind === 'record' && item.data.note }}">{{ item.data.note }}</view>

        <!-- 巡查照片/视频 -->
        <view class="media-grid" wx:if="{{ item.kind === 'record' && item.data.media.length }}">
          <block wx:for="{{ item.data.media }}" wx:for-item="m" wx:key="media_id">
            <view wx:if="{{ m.kind === 'photo' }}" class="media-cell-wrap" data-id="{{ m.media_id }}" bindtap="preview">
              <image class="media-img" src="{{ photoPaths[m.media_id] }}" mode="aspectFill" />
            </view>
            <view wx:else class="media-cell-wrap video-thumb" data-id="{{ m.media_id }}" bindtap="playVideo">
              <view class="video-thumb-bg"></view>
              <view class="video-play-btn">▶</view>
              <text class="video-thumb-label">视频</text>
            </view>
          </block>
        </view>

        <!-- 隐患块（日常巡查下挂 + 独立隐患） -->
        <block wx:for="{{ item.kind === 'record' ? item.data.hazards : [item.data] }}" wx:for-item="h" wx:key="hazard_id">
          <view class="hazard-block {{ h.status === 'closed' ? 'hazard-closed' : '' }}">
            <!-- 隐患进度条 -->
            <view class="hazard-steps">
              <view wx:for="{{ h.steps }}" wx:for-item="s" wx:key="key" class="hazard-step {{ s.done ? 'done' : '' }} {{ s.current ? 'current' : '' }}">
                <view class="hazard-step-line"></view>
                <view class="hazard-step-dot"></view>
                <view class="hazard-step-label">{{ s.label }}</view>
              </view>
            </view>

            <view class="hazard-meta">
              <text class="tag tag-info" wx:if="{{ h.hazard_type }}">{{ h.hazard_type }}</text>
              <text class="tag tag-pending" wx:if="{{ h.risk_level }}">{{ h.risk_level }}</text>
            </view>

            <view class="shot-grid" wx:if="{{ h.shots.length }}">
              <image wx:for="{{ h.shots }}" wx:for-item="s" wx:key="shot_id" class="shot-img" src="{{ shotPaths[s.shot_id] }}" mode="aspectFill" data-id="{{ s.shot_id }}" bindtap="previewShot" />
            </view>

            <view class="hazard-desc">{{ h.description }}</view>
            <view class="hazard-req" wx:if="{{ h.rectify_requirement }}">整改要求：{{ h.rectify_requirement }}</view>

            <!-- 嵌套整改记录 -->
            <view class="rectify-list" wx:if="{{ h.rectifyRecords.length }}">
              <view class="rectify-title">整改记录（{{ h.rectifyRecords.length }}）</view>
              <view wx:for="{{ h.rectifyRecords }}" wx:for-item="rr" wx:key="record_id" class="rectify-item">
                <view class="rectify-head">
                  <text class="muted">{{ rr.created_by_name || '-' }} · {{ rr.created_at }}</text>
                </view>
                <view class="rectify-note" wx:if="{{ rr.note }}">{{ rr.note }}</view>
                <view class="media-grid" wx:if="{{ rr.media.length }}">
                  <block wx:for="{{ rr.media }}" wx:for-item="rm" wx:key="media_id">
                    <view wx:if="{{ rm.kind === 'photo' }}" class="media-cell-wrap" data-id="{{ rm.media_id }}" bindtap="preview">
                      <image class="media-img" src="{{ photoPaths[rm.media_id] }}" mode="aspectFill" />
                    </view>
                    <view wx:else class="media-cell-wrap video-thumb" data-id="{{ rm.media_id }}" bindtap="playVideo">
                      <view class="video-thumb-bg"></view>
                      <view class="video-play-btn">▶</view>
                      <text class="video-thumb-label">视频</text>
                    </view>
                  </block>
                </view>
              </view>
            </view>

            <view class="hazard-req" wx:if="{{ h.review_comment }}">复核意见：{{ h.review_comment }}</view>

            <view class="hazard-ops">
              <button wx:if="{{ h.status === 'rectifying' }}" class="mini-btn" size="mini" data-id="{{ h.hazard_id }}" bindtap="submitReview">提交复核</button>
              <text class="link-btn" data-id="{{ h.hazard_id }}" bindtap="editHazard">修改</text>
              <text class="link-btn danger" data-id="{{ h.hazard_id }}" bindtap="deleteHazard">删除</text>
            </view>
          </view>
        </block>
      </view>
    </block>

    <view wx:if="{{ !groups.length }}" class="muted">暂无巡查记录</view>
  </view>

  <view class="actions">
    <button class="btn-primary" bindtap="goUpload">上传照片/视频</button>
  </view>
</view>
