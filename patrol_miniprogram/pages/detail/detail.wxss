.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.event-no {
  font-family: Consolas, monospace;
  font-size: 32rpx;
  font-weight: 600;
  color: #246f5d;
}

.info-row {
  display: flex;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: #4a5450;
}
.info-row:last-child {
  margin-bottom: 0;
}
.info-label {
  flex: 0 0 140rpx;
  color: #9aa5a1;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}
.photo-img {
  width: 100%;
  height: 260rpx;
  border-radius: 8rpx;
  background: #eef2f0;
}
