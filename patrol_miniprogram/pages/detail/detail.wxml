<view class="page" wx:if="{{ event }}">
  <!-- 事件信息 -->
  <view class="card">
    <view class="head-row">
      <text class="event-no">{{ event.event_no }}</text>
      <text wx:if="{{ event.status === 'pending' }}" class="tag tag-pending">待核查</text>
      <text wx:elif="{{ event.status === 'archived' }}" class="tag tag-archived">已归档</text>
      <text wx:elif="{{ event.review_result === 'noncompliant' }}" class="tag tag-noncompliant">不符合</text>
      <text wx:else class="tag tag-compliant">符合</text>
    </view>
    <view class="info-row"><text class="info-label">线路</text><text>{{ event.line || '-' }}</text></view>
    <view class="info-row"><text class="info-label">施工类型</text><text>{{ event.construction_type || '-' }}</text></view>
    <view class="info-row"><text class="info-label">位置描述</text><text>{{ event.location_desc || '-' }}</text></view>
    <view class="info-row"><text class="info-label">坐标</text><text>{{ event.longitude != null ? event.longitude + ', ' + event.latitude : '-' }}</text></view>
    <view class="info-row"><text class="info-label">施工单位</text><text>{{ event.constructor || '-' }}</text></view>
    <view class="info-row"><text class="info-label">上报人</text><text>{{ event.reporter_name || '-' }}{{ event.reporter_unit ? ' / ' + event.reporter_unit : '' }}</text></view>
    <view class="info-row"><text class="info-label">上报时间</text><text>{{ event.created_at }}</text></view>
    <view class="info-row" wx:if="{{ event.remark }}"><text class="info-label">备注</text><text>{{ event.remark }}</text></view>
    <block wx:if="{{ event.status === 'reviewed' || event.status === 'archived' }}">
      <view class="info-row">
        <text class="info-label">核查结论</text>
        <text wx:if="{{ event.review_result === 'compliant' }}" class="tag tag-compliant">符合</text>
        <text wx:else class="tag tag-noncompliant">不符合</text>
      </view>
      <view class="info-row"><text class="info-label">核查人</text><text>{{ event.reviewer || '-' }}</text></view>
      <view class="info-row" wx:if="{{ event.review_comment }}"><text class="info-label">核查意见</text><text>{{ event.review_comment }}</text></view>
    </block>
  </view>

  <!-- 现场照片 -->
  <view class="card">
    <view class="section-title">现场照片（{{ event.photos.length }}）</view>
    <view wx:if="{{ event.photos.length }}" class="photo-grid">
      <image
        wx:for="{{ event.photos }}"
        wx:key="photo_id"
        class="photo-img"
        src="{{ photoPaths[item.photo_id] }}"
        mode="aspectFill"
        data-id="{{ item.photo_id }}"
        bindtap="previewPhoto"
      />
    </view>
    <view wx:else class="muted">暂无照片</view>
  </view>
</view>

<view class="empty" wx:elif="{{ !loading }}">
  <view class="icon">🔍</view>
  <view>事件不存在或已删除</view>
</view>
