/* ===== 顶部欢迎区 ===== */
.hero {
  margin: -24rpx -24rpx 24rpx;
  padding: 36rpx 32rpx 32rpx;
  background: linear-gradient(150deg, #13294b 0%, #1b3a67 46%, #2d5d95 100%);
  border-bottom-left-radius: 28rpx;
  border-bottom-right-radius: 28rpx;
}
.hero-inner { display: flex; align-items: flex-start; justify-content: space-between; }
.hero-hello { font-size: 38rpx; font-weight: 700; color: #fff; letter-spacing: 1rpx; }
.hero-sub { margin-top: 10rpx; font-size: 22rpx; color: rgba(255,255,255,0.65); }
.logout-btn {
  margin: 0;
  background: rgba(255,255,255,0.14);
  color: #fff;
  font-size: 22rpx;
  border-radius: 999rpx;
}
.logout-btn::after { border: none; }

/* 统计卡片 */
.stat-row {
  margin-top: 30rpx;
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 0;
  box-shadow: 0 8rpx 26rpx rgba(9, 25, 51, 0.18);
}
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #1f2d3d; line-height: 1.2; }
.stat-label { margin-top: 6rpx; font-size: 21rpx; color: #909399; }
.stat-warn .stat-num { color: #f56c6c; }
.stat-divider { width: 1rpx; background: #eef2f8; }

/* ===== 任务卡片 ===== */
.task-card {
  display: flex;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 58, 103, 0.06);
}
.card-hover { transform: scale(0.99); box-shadow: 0 4rpx 16rpx rgba(27, 58, 103, 0.12); }
.bar { flex: 0 0 8rpx; }
.bar-pending { background: #e6a23c; }
.bar-doing { background: #409eff; }
.bar-done { background: #67c23a; }
.task-body { flex: 1; padding: 24rpx; min-width: 0; }

.task-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.task-top-tags { display: flex; align-items: center; gap: 8rpx; }
.task-no { font-family: Consolas, monospace; font-size: 28rpx; font-weight: 600; color: #2d5d95; }
.st-pending { background: #fdf6ec; color: #e6a23c; }
.st-doing { background: #ecf5ff; color: #409eff; }
.st-done { background: #f0f9eb; color: #67c23a; }
.tag-overdue { background: #fef0f0; color: #f56c6c; font-weight: 600; }

.task-name { font-size: 31rpx; font-weight: 600; color: #303133; margin-bottom: 8rpx; }
.task-line { font-size: 25rpx; color: #606266; margin-bottom: 14rpx; }

.task-meta { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.meta-chip {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f4f7fb;
  color: #6b7a90;
  font-size: 21rpx;
}
.meta-chip.warn { background: #fef0f0; color: #f56c6c; }
.meta-time { margin-left: auto; font-size: 22rpx; color: #a8abb2; }
.arrow { font-size: 40rpx; line-height: 1; color: #c0c8d4; font-weight: 300; }

/* ===== 空状态 / 加载 ===== */
.empty { padding: 130rpx 0 100rpx; text-align: center; color: #909399; }
.empty-icon { font-size: 88rpx; margin-bottom: 20rpx; opacity: 0.75; }
.empty-title { font-size: 30rpx; color: #606266; }
.empty-sub { margin-top: 10rpx; font-size: 24rpx; color: #a8abb2; }
.loading-tip { padding: 20rpx 0 40rpx; text-align: center; color: #909399; font-size: 24rpx; }
