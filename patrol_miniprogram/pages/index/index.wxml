<view class="page">
  <view class="head">
    <view>
      <text class="head-name">我的任务</text>
      <text class="muted">{{ tasks.length }} 个</text>
    </view>
    <button class="logout" size="mini" bindtap="logout">退出</button>
  </view>

  <view wx:if="{{ tasks.length }}" class="task-list">
    <view wx:for="{{ tasks }}" wx:key="task_id" class="card task-card" data-id="{{ item.task_id }}" bindtap="openTask">
      <view class="task-top">
        <text class="task-no">{{ item.task_no }}</text>
        <text class="tag {{ item.status === 'pending' ? 'tag-pending' : (item.status === 'completed' ? 'tag-compliant' : 'tag-archived') }}">{{ item.statusLabel }}</text>
      </view>
      <view class="task-name">{{ item.name }}</view>
      <view class="task-line">{{ item.line || '未填线路' }}<text wx:if="{{ item.location_desc }}"> · {{ item.location_desc }}</text></view>
      <view class="task-meta">
        <text>共 {{ item.hazard_count || 0 }} 个隐患</text>
        <text class="open-hazard" wx:if="{{ item.open_hazard_count > 0 }}">剩余 {{ item.open_hazard_count }} 个未闭环</text>
        <text>{{ item.record_count || 0 }} 条记录</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{ !loading }}" class="empty">
    <view class="icon">📋</view>
    <view>暂无指派给我的任务</view>
  </view>
</view>
