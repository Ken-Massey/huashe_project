<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.rail.RailAuditFlowNodeMapper">

    <resultMap type="com.ruoyi.system.domain.rail.RailAuditFlowNode" id="RailAuditFlowNodeResult">
        <id property="nodeId" column="node_id"/>
        <result property="flowCode" column="flow_code"/>
        <result property="nodeCode" column="node_code"/>
        <result property="nodeName" column="node_name"/>
        <result property="nodeOrder" column="node_order"/>
        <result property="roleKey" column="role_key"/>
        <result property="projectType" column="project_type"/>
        <result property="stageName" column="stage_name"/>
        <result property="allowReturn" column="allow_return"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectNodeColumns">
        node_id, flow_code, node_code, node_name, node_order, role_key, project_type,
        stage_name, allow_return, status, create_by, create_time, update_by, update_time, remark
    </sql>

    <select id="selectNodeByCode" parameterType="com.ruoyi.system.domain.rail.RailAuditFlowNode" resultMap="RailAuditFlowNodeResult">
        select <include refid="selectNodeColumns"/>
        from rail_audit_flow_node
        where flow_code = #{flowCode}
          and node_code = #{nodeCode}
          and status = '0'
        limit 1
    </select>

    <select id="selectNextNode" parameterType="com.ruoyi.system.domain.rail.RailAuditFlowNode" resultMap="RailAuditFlowNodeResult">
        select <include refid="selectNodeColumns"/>
        from rail_audit_flow_node
        where flow_code = #{flowCode}
          and status = '0'
          and node_order &gt; (
              select node_order
              from rail_audit_flow_node
              where flow_code = #{flowCode}
                and node_code = #{nodeCode}
              limit 1
          )
        order by node_order asc
        limit 1
    </select>

    <select id="selectNodeList" parameterType="com.ruoyi.system.domain.rail.RailAuditFlowNode" resultMap="RailAuditFlowNodeResult">
        select <include refid="selectNodeColumns"/>
        from rail_audit_flow_node
        <where>
            <if test="flowCode != null and flowCode != ''">and flow_code = #{flowCode}</if>
            <if test="projectType != null and projectType != ''">and (project_type is null or project_type = #{projectType})</if>
            <if test="stageName != null and stageName != ''">and (stage_name is null or stage_name = #{stageName})</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by node_order asc, node_id asc
    </select>

</mapper>
